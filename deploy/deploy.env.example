# Compose interpolation only; contains no application credentials.
IMAGE_PREFIX=ghcr.io/m4anuel/betterilias
# Select the same unique CI build tag for both images after CI publishes it.
IMAGE_TAG=build-REPLACE_WITH_RUN_ID-REPLACE_WITH_RUN_ATTEMPT
APP_DOMAIN=betterilias.ch
ACME_EMAIL=manuel@betterilias.ch
# Only Caddy publishes host ports. Leave loopback binding for local smoke tests.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_ENV_FILE=./backend.env
