{
  "manifest_version": 3,
  "name": "Better Ilias Companion",
  "version": "1.1.1",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": ["cookies", "storage", "tabs", "alarms"],
  "host_permissions": ["https://ilias.unibe.ch/*", "https://betterilias.ch/*"],
  "background": {"scripts": ["config.js", "core.js", "background.js"]},
  "action": {
    "default_popup": "popup.html", "default_title": "__MSG_title__",
    "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}
  },
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "64": "icon64.png", "120": "icon120.png", "128": "icon128.png", "152": "icon152.png", "167": "icon167.png", "180": "icon180.png", "256": "icon256.png", "512": "icon512.png", "1024": "icon1024.png"},
  "content_scripts": [
    {"matches": ["https://betterilias.ch/*"], "js": ["config.js", "content.js"], "run_at": "document_start"},
    {"matches": ["https://ilias.unibe.ch/*"], "js": ["ilias.js"], "run_at": "document_idle"}
  ],
  "browser_specific_settings": {"safari": {"strict_min_version": "16.4"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
