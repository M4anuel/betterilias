# Allowlist: private data, worktrees, .env files, fixtures and Git never enter
# either build context. Keep this narrower than .gitignore.
**
!backend/
!backend/**
!locales/
!locales/**
!requirements-runtime.txt
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/admin/
!frontend/admin/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!scripts/
!scripts/sync-extension-locales.mjs
!scripts/check-locales.mjs
!extensions/
!extensions/chrome/
!extensions/chrome/**
!extensions/firefox/
!extensions/firefox/**
!deploy/
!deploy/backend.Dockerfile
!deploy/frontend.Dockerfile
!deploy/frontend.Caddyfile
!deploy/runtime.py
**/node_modules
**/__pycache__
**/*.pyc
**/.env*
**/*.env
**/*.env.*
**/.sessions
**/.calendar
**/.staged_imports
**/.coordination
**/.observability
**/.diagnostic_reports
**/logs
**/session_cookies.json
