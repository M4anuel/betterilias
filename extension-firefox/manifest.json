{
  "manifest_version": 3,
  "name": "BetterIlias Companion",
  "version": "1.0.0",
  "description": "Synchronisiert deine Uni Bern ILIAS-Sitzung sicher mit BetterIlias.",
  "browser_specific_settings": {
    "gecko": {
      "id": "betterilias-companion@m4anuel.ch",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://ilias.unibe.ch/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BetterIlias Sync",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ilias.unibe.ch/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
