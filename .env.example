# Production is the default; start.py explicitly selects development.
APP_ENV=production
# All replicas on ONE VPS must share this local volume and all persisted data.
COORDINATION_DIR=.coordination
SESSIONS_DIR=.sessions

# Aggregate outbound budgets for ALL workers on this VPS, including downloads.
# Defaults are conservative application settings, not university-approved limits.
# Every worker must use identical values. Stop ALL workers before changing them;
# remove only COORDINATION_DIR/outbound.sqlite3 while stopped, then restart.
OUTBOUND_MAX_CONCURRENCY=6
OUTBOUND_PER_SESSION_CONCURRENCY=2
OUTBOUND_REQUESTS_PER_SECOND=5
OUTBOUND_QUEUE_LIMIT=512
OUTBOUND_PER_SESSION_QUEUE_LIMIT=32
OUTBOUND_QUEUE_TIMEOUT_SECONDS=20
OUTBOUND_READ_RETRIES=2
OUTBOUND_COALESCE_MAX_BYTES=2097152
# Exact HTTPS origins only; no domain wildcards. External requests never get cookies.
OUTBOUND_MEDIA_ORIGINS=["https://opencast.unibe.ch", "https://dist.opencast.unibe.ch"]
# Opt-in ONLY for a local ILIAS test installation with APP_ENV=development.
# Production always rejects private/local destination addresses.
OUTBOUND_ALLOW_LOCAL_ILIAS=false

# ILIAS Settings
ILIAS_BASE_URL=https://ilias.unibe.ch
ILIAS_CLIENT_ID=ilias3_unibe

# Session & Logs
SESSION_COOKIE_FILE=session_cookies.json
LOGS_DIR=logs
# Private diagnostics: exclude from static serving and routine backups.
OBSERVABILITY_DIR=.observability
# Structured JSON to stderr; affects console only, not private event retention.
# INFO, WARNING, ERROR or OFF. Apply expiry to supervisor/container logs too.
LOG_CONSOLE_LEVEL=INFO
OBSERVABILITY_RETENTION_DAYS=7
OBSERVABILITY_MAX_EVENTS=50000
OBSERVABILITY_MAX_MB=32
OBSERVABILITY_QUEUE_SIZE=2048
# Empty disables read-only admin routes. Generate a separate random key with
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never put this key in frontend code, URLs, or extension storage.
ADMIN_API_KEY=
# Raw parser captures require BOTH development mode and this explicit opt-in.
CAPTURE_FAILED_HTML=false
FAILED_HTML_RETENTION_HOURS=24
FAILED_HTML_MAX_FILES=20
FAILED_HTML_MAX_BYTES=1048576

# API Server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_SECONDS=240
